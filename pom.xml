<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>club.xiaojiawei</groupId>
    <artifactId>javafx-ui</artifactId>
    <version>3.0.0</version>
    <name>javafx-ui</name>

    <repositories>
        <!-- SVG library is built from source by JitPack. -->
        <repository>
            <id>jitpack.io</id>
            <url>https://jitpack.io</url>
        </repository>
    </repositories>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <javafx-version>21.0.8</javafx-version>
        <lombok-version>1.18.34</lombok-version>
        <java.version>21</java.version>
        <skipTests>false</skipTests>
        <javafx-svg.version>e8d64c5a7491f67e7a448a9dbf2eac594f99cf4f</javafx-svg.version>
    </properties>

    <distributionManagement>
        <repository>
            <id>nexus-releases</id>
            <name>Nexus Release Repository</name>
            <url>http://192.168.1.100:3011/repository/nexus-releases/</url>
        </repository>
    </distributionManagement>

    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok-version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx-version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>${javafx-version}</version>
        </dependency>
        <!--svg加载库-->
        <dependency>
            <groupId>com.github.xjw580</groupId>
            <artifactId>javafx-svg</artifactId>
            <version>${javafx-svg.version}</version>
        </dependency>
        <!--媒体类型库-->
        <dependency>
            <groupId>org.apache.tika</groupId>
            <artifactId>tika-core</artifactId>
            <version>2.9.1</version>
        </dependency>

    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <excludes>
                    <!--                    <exclude>**/demo/**</exclude>-->
                    <!--                    <exclude>**/test/**</exclude>-->
                </excludes>
            </resource>
            <resource>
                <directory>${project.build.directory}/generated-resources/themes</directory>
            </resource>
        </resources>
        <plugins>
            <!-- Generate runtime CSS from the single source for each theme component. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>generate-theme-css</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <exec executable="${java.home}/bin/java" failonerror="true">
                                    <arg value="--source"/>
                                    <arg value="${java.version}"/>
                                    <arg value="${project.basedir}/tools/GenerateThemeCss.java"/>
                                    <arg value="${project.basedir}/src/main/themes"/>
                                    <arg value="${project.build.directory}/generated-resources/themes"/>
                                </exec>
                            </target>
                        </configuration>
                    </execution>
                    <execution>
                        <id>verify-theme-css-generator</id>
                        <phase>test</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <skip>${skipTests}</skip>
                            <target>
                                <mkdir dir="${project.build.directory}/theme-verification"/>
                                <javac destdir="${project.build.directory}/theme-verification"
                                       release="${java.version}" encoding="UTF-8" includeantruntime="false">
                                    <src path="${project.basedir}/tools"/>
                                    <src path="${project.basedir}/verification"/>
                                    <include name="GenerateThemeCss.java"/>
                                    <include name="ThemeCssGenerationVerification.java"/>
                                </javac>
                                <java classname="ThemeCssGenerationVerification" fork="true"
                                      failonerror="true" dir="${project.basedir}">
                                    <classpath>
                                        <pathelement location="${project.build.directory}/theme-verification"/>
                                    </classpath>
                                </java>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.10.1</version>
                <configuration>
                    <annotationProcessorPaths>
                        <annotationProcessorPath>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok-version}</version>
                        </annotationProcessorPath>
                    </annotationProcessorPaths>
                    <excludes>
                        <!--                        <exclude>**/demo/**</exclude>-->
                        <!--                        <exclude>**/test/**</exclude>-->
                    </excludes>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                </configuration>
            </plugin>
            <!--Maven编译插件-->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>3.3.0</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.6.0</version>
                <configuration>
                    <!-- jdk1.8要加上，1.7要去掉，否则会报错 -->
                    <additionalJOptions>
                        <additionalJOption>-Xdoclint:none</additionalJOption>
                    </additionalJOptions>
                </configuration>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>